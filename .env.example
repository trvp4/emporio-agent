# LLM provider: "anthropic" (default) or "openai" (any OpenAI-compatible endpoint)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# How much the model thinks before answering: low, medium, high (Anthropic only).
# Empty uses the model's default (medium on claude-haiku-5-5).
LLM_EFFORT=

# Only needed when LLM_PROVIDER=openai (OpenAI, Groq, Gemini OpenAI-compatible endpoint, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Simulated "now" for the store. The dataset's latest order is from 2026-03-22,
# so dates are anchored to a moment right after it. Leave empty to use the real clock.
STORE_NOW=2026-03-25T10:30:00
